# Copy this file to `secrets.yaml` and fill in your actual credentials.
# Make sure `secrets.yaml` is listed in your `.gitignore` file!

# Wi-Fi Credentials
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Fallback Captive Portal Hotspot Password (minimum 8 characters)
hotspot_password: "YOUR_FALLBACK_HOTSPOT_PASSWORD"

# Home Assistant Native API Encryption Key (32-byte base64 encoded string)
# Generate a new key in ESPHome Dashboard or run: `openssl rand -base64 32`
api_encryption_key: "YOUR_32_BYTE_BASE64_API_KEY"
